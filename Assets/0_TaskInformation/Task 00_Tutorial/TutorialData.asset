  plant_header:
  - Greifen
  - Einpflanzen
  plant_texts:
  - "Greife den blauen W\xFCrfel unter mir mit Daumen und Zeigefinger."
  - "Greife den blauen W\xFCrfel unter mir mit Daumen und Zeigefinger.\nLasse ihn
    hier los, damit pflanzt di ihn ein."
  plant_clips:
  - {fileID: 8300000, guid: 33bc1a48ca5fef3489fa532a74f75b8d, type: 3}
